# Sanity CMS Configuration
# Project ID from Sanity Manage dashboard
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Environment separation: use 'development' for local/staging, 'production' for live production
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# API Write Token for local seeding & mutation operations (keep secret, never expose to client)
SANITY_API_WRITE_TOKEN=

# Optional API Read Token for draft previews
SANITY_API_READ_TOKEN=

# Secret token for authenticating Sanity CMS On-Demand Webhook Revalidation (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# Mock Data Settings (set to 'true' to use local static mock data, 'false' for Sanity CMS)
USE_MOCK_DATA=false
